{
    "name": "CWE 416: Use After Free",
    "severity": "high",
    "notes": "does not cover cases where the freed address is passed as an argument to a function, not exhaustive",
    "sequences": [{
        "model": [
        {"action": "FREE", "as": {"ptr": "ptr", "ptr.label": "ptr.label"}},
        {"type": "anti", "group": "1", "action": "ALLOCATE", "as": {"fname": "fname"}},
        {"type": "anti", "group": "1", "action": "RET", "as": {"addr": "faddr", "ret.fname": "returned_from"}, "cond": [ {"ls": "returned_from", "op": "eq", "rs": "fname"}, {"ls": "faddr", "op": "eq", "rs": "ptr"}, {"ls": "discrete_time", "op": "leq", "rs": 3}]},
        {"action": "VAR", "as": {"base": "addr", "base.label": "base.label"}, "cond": [
            {"or": [{"ls": "ptr", "op": "eq", "rs": "addr"}, {"ls": "base.label", "op": "like", "rs": "ptr.label"}]}]}
        ],
        "vtypes": {"ptr": "int", "addr": "int"}
        }
    ]
